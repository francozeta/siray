{
  "name": "siray",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "pnpm": "9.15.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:conventions",
    "test:unit": "vitest run",
    "test:conventions": "node --test scripts/validate-pr-metadata.test.mjs",
    "db:start": "supabase db start",
    "db:stop": "supabase stop --no-backup",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --level error",
    "db:test": "supabase test db --local",
    "db:types": "node scripts/generate-database-types.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@shadcn/react": "^0.3.0",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.3",
    "recharts": "3.8.0",
    "server-only": "0.0.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "supabase": "2.115.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@9.15.3"
}
