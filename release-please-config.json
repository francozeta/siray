{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "d18871b110b087b5cffad7a017dfeec0804531fd",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "siray",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "include-v-in-release-name": true,
      "draft-pull-request": true,
      "pull-request-title-pattern": "chore${scope}: release ${version}",
      "pull-request-header": "## Proposed release\n\nThis version was calculated from publishable pull requests merged into `main`. Review the scope and version before marking this pull request ready.",
      "pull-request-footer": "Generated by Release Please. Merging this pull request creates the tag and GitHub Release.",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug fixes"
        }
      ]
    }
  }
}
