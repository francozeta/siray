# Browser-safe Supabase connection values from the project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Required only for database deployment automation, never for browser code.
SUPABASE_ACCESS_TOKEN=your_personal_access_token
SUPABASE_DB_PASSWORD=your_database_password
SUPABASE_PROJECT_ID=your_project_ref

# Add this only when a server-side administrative flow is implemented.
# Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your_key
